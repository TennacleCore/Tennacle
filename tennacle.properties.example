# Copy to tennacle.properties (or set any of these as -D system properties or TENNACLE_* environment
# variables, which win over the file). Every value here is the default.

# where the socket listens. A non-loopback bind REQUIRES a forwarding secret below: without one, any direct
# connection can hand over whatever account name it likes
tennacle.bind = 127.0.0.1
tennacle.port = 25566

# proxy forwarding. Velocity modern forwarding is the production answer; bungeeguard tokens are comma separated
# tennacle.velocity-secret = <the proxy's forwarding secret>
# tennacle.bungeeguard-tokens = <token>,<token>

# generated into <data-dir>/game-secret on first boot when unset; rotating it stops old screenshots deriving ids
# tennacle.game-secret = <32+ random characters>

tennacle.data-dir = data
tennacle.arena-dir = arenas

# hands every player the staff tools (/gamemode, /lag, /shard stall and friends), which otherwise need
# tennacle.staff.<command> or a role holding it. On by default only on a loopback bind
# tennacle.dev-commands = false

# usernames or uuids that are always admin, comma separated: who hands out /role on a fresh server
# tennacle.owners = Term4

# chat-narrates every Animatium feature send to the player it is sent to
# tennacle.animatium-debug = false

# an HTTP endpoint answering /health with tick rate, players and games; 0 = off
# tennacle.health-port = 8080
# tennacle.health-bind = 127.0.0.1

tennacle.chunk-view-distance = 8
tennacle.entity-view-distance = 5

# how long an arena with no game on it stays instantiated
tennacle.map-idle-minutes = 10

# the tint order a team with nothing authored falls back to, as named wire colors
# tennacle.palette = red,blue,green,yellow,aqua,light_purple,dark_purple,gold

# network-wide block roles over every map's own; where the palette changes the hue, this changes the block
# tennacle.look = blocks=slime_block,cage=glass

# Polyp's legacy inventory slot fix; off only to measure what it costs
# tennacle.inventory-sync = true

# this file's own path, as a system property only (it is read before the file is)
# -Dtennacle.config = tennacle.properties

# Archipelago reads its own directories from archipelago.properties beside this one, or -Darchipelago.<key>.
# Defaults, all relative to the working directory:
#   replay-dir  = replays
#   save-dir    = shard-saves
#   crash-dir   = archipelago-crashes

# Hypixel API key for /import (players copy their Hypixel layouts); leave unset to turn importing off
# tennacle.hypixel-api-key =
